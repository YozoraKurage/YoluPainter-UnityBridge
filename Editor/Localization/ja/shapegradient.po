# Japanese translation for YoluPainter: the shape gradient generator (Properties ▸ Filters ▸ the generator's shape, placement and
# scene copy) and its gizmo in the 3D view.
msgid ""
msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

# ── Generator の名前と形 ──

msgid "Shape gradient"
msgstr "形のグラデーション"

msgctxt "shape gradient"
msgid "Shape"
msgstr "形"

msgctxt "shape gradient"
msgid "Box"
msgstr "ボックス"

msgctxt "shape gradient"
msgid "Sphere"
msgstr "球"

msgctxt "shape gradient"
msgid "Plane"
msgstr "平面"

msgid "Box: 1 inside, fading to 0 at its faces. Sphere: the same toward its surface. Plane: 0 behind it to 1 in front of it, across its width."
msgstr "ボックス: 中は 1、面に向かって 0 へ。球: 表面に向かって同じく。平面: 後ろの 0 から前の 1 へ、幅のあいだで変わります。"

# ── 3D ビューで編集 ──

msgid "Edit in 3D View"
msgstr "3D ビューで編集"

msgid "Handles: move (arrows along the model's axes, the square in the view's plane)"
msgstr "ハンドル: 移動（矢印はモデルの軸に沿って、中央の四角は画面に平行な面の中で）"

msgid "Handles: rotate (rings about the model's axes; Ctrl snaps to 15°)"
msgstr "ハンドル: 回転（モデルの軸のまわりの輪。Ctrl で 15° ごと）"

msgid "The shape drag was cancelled; the shape is where it was."
msgstr "形のドラッグを取り消しました。形は元の所のままです。"

# ── 置き場 ──

msgid "Placement"
msgstr "置き場"

msgid "In the model root's space: its position and rotation, in scene units (the root's scale is not applied). The same values as the handles in the 3D view."
msgstr "モデルのルートの位置と向きを基準にした空間で、単位はシーンの単位です（ルートの大きさ（scale）は掛けません）。3D ビューのハンドルと同じ値です。"

msgctxt "shape gradient"
msgid "Rotation"
msgstr "回転"

msgid "Euler angles in degrees, as Unity's Transform shows them (turned about Z, then X, then Y)."
msgstr "オイラー角（度）。Unity の Transform と同じ見せ方です（Z、X、Y の順に回します）。"

msgctxt "shape gradient"
msgid "Size"
msgstr "大きさ"

msgid "The box's full width along each of its own axes (scene units)."
msgstr "ボックス自身の軸ごとの幅（全体の幅、シーンの単位）。"

msgctxt "shape gradient"
msgid "Radius"
msgstr "半径"

msgid "The sphere's radius (scene units)."
msgstr "球の半径（シーンの単位）。"

msgctxt "shape gradient"
msgid "Width"
msgstr "幅"

msgid "How far the value takes to go from 0 behind the plane to 1 in front of it (scene units). The plane faces its own +Y."
msgstr "値が平面の後ろの 0 から前の 1 まで変わるあいだの距離（シーンの単位）。平面は自身の +Y を向きます。"

msgctxt "shape gradient"
msgid "Falloff"
msgstr "ぼかし幅"

msgid "How much of the inside fades from 1 to 0 at the boundary: 0 %: a hard edge; 100 %: the fade reaches the middle (the thinnest axis of a box)."
msgstr "内側のどれだけを使って、境目で 1 から 0 へ薄れさせるか: 0 % は硬い縁、100 % は中心まで薄れます（ボックスはいちばん薄い軸で）。"

# ── シーンから写す ──

msgid "From the Scene"
msgstr "シーンから"

msgid "Copies a scene object's shape relative to the model root once: its BoxCollider or SphereCollider, or else its position, rotation and scale. The scene is only read, never changed."
msgstr "シーンの物の形を、モデルのルートからの相対で 1 回写します: BoxCollider か SphereCollider があればその形、無ければ位置・回転・大きさ。シーンは読むだけで、変えません。"

msgid "Pick a scene object to copy its shape from (read only)"
msgstr "形を写すシーンの物を選ぶ（読むだけ）"

msgid "Forget the object (the copied shape stays)"
msgstr "物の選択を外す（写した形はそのまま）"

msgid "Copy from the Scene Again"
msgstr "シーンから取り直す"

msgid "Reads the object's shape again (after you moved it in the scene). One undo step."
msgstr "物の形を読み直します（シーンで動かした後など）。1 回の Undo になります。"

msgid "'{0}' cannot be used: {1}"
msgstr "'{0}' は使えません: {1}"

msgid "'{0}' is not an object in an open scene."
msgstr "'{0}' は開いているシーンの物ではありません。"
