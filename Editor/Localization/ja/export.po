# Japanese translation for YoluPainter: the export templates (File ▸ Export ▸ Images for Unity Standard / URP, HDRP, lilToon).
msgid ""
msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Images for {0}…"
msgstr "{0} 向けの画像…"

msgid "Nothing to export for {0}: no layer uses a channel it reads."
msgstr "{0} 向けに書き出すものがありません。どのレイヤーも、読むチャンネルを使っていません。"

msgid "Export images for {0} into folder"
msgstr "{0} 向けの画像を書き出すフォルダ"

msgid "Exported {0} image(s) for {1} to {2}."
msgstr "{1} 向けに {0} 枚の画像を {2} に書き出しました。"

msgid "A texture set has no current AO bake, so its occlusion is white (no occlusion)."
msgstr "今の条件で焼いた AO が無いテクスチャセットがあるので、その遮蔽は白（遮蔽なし）にしました。"

msgid "No material was changed."
msgstr "マテリアルは変えていません。"

# ── 書き出しのパディング（Project/TexturePaintWindow.ExportPadding.cs） ──

msgid "No export padding: load the model in the 3D view so its UVs are known."
msgstr "書き出しのパディングをしていません。UV が分かるように、3D ビューにモデルを読み込んでください。"

msgid "No export padding for {0}: no UV triangle of its material slot."
msgstr "{0} は書き出しのパディングをしていません。そのマテリアルのスロットに UV の三角形がありません。"
