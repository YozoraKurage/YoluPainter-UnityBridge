# Japanese translation for YoluPainter: generators (Properties ▸ Filters: values made from the texture set's baked mesh maps,
# the maps they read and their state, the parameters, and the notes when exporting or saving without usable maps).
msgid ""
msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

# ── 足す ──

msgid "Add a generator on the pixels (values from the baked mesh maps)"
msgstr "画素に Generator を足す（焼いたメッシュマップから値を作ります）"

msgid "Add a generator on the mask (where the layer shows, from the baked mesh maps)"
msgstr "マスクに Generator を足す（レイヤーの見える所を、焼いたメッシュマップから作ります）"

msgid "It has no effect until its mesh maps are baked: {0}"
msgstr "メッシュマップを焼くまで効きません: {0}"

msgid "Edge wear"
msgstr "エッジの摩耗"

msgid "Dirt"
msgstr "汚れ・隙間"

msgid "Position gradient"
msgstr "位置の勾配"

msgctxt "generator"
msgid "Thickness"
msgstr "厚み"

msgctxt "generator"
msgid "Direction"
msgstr "向き"

msgid "no maps"
msgstr "マップなし"

# メニューの見出し（Filter ▸ Generator ▸ …。メニューはメインが足す）
msgid "Generator"
msgstr "Generator"

# ── 読むマップ ──

msgid "Reads"
msgstr "読むマップ"

msgid "The texture set's baked mesh maps this generator reads. They come from the model; painting (Height too) does not change them."
msgstr "この Generator が読む、テクスチャセットの焼いたメッシュマップです。モデルから焼いたもので、描いても（Height も）変わりません。"

msgid "this bake"
msgstr "このベイク"

msgid "other bake"
msgstr "別のベイク"

msgid "baked from the model"
msgstr "モデルから焼いた"

msgid "baked from a high poly"
msgstr "高ポリから焼いた"

msgid "Bake {0}"
msgstr "ベイク {0}"

msgid "No effect now: the input passes through unchanged. {0}"
msgstr "今は効きません（入力をそのまま通します）。{0}"

msgid "Only this bake"
msgstr "このベイクだけを読む"

msgid "On: keep reading exactly the bake shown above. A rebake under other conditions is then not used (the generator has no effect until you turn this on again). Off: follow the latest bake."
msgstr "オン: 上に出ているベイクだけを読み続けます。別の条件で焼き直したマップは使いません（入れ直すまで Generator は効きません）。オフ: いちばん新しいベイクを読みます。"

# ── 種類ごとの値 ──

msgid "AO ↔ Cavities"
msgstr "AO ↔ 隙間"

msgid "0 %: ambient occlusion only. 100 %: cavities (concave curvature) only."
msgstr "0 %: 環境遮蔽だけ。100 %: 隙間（曲率の凹）だけ。"

msgid "Curvature comes from the model's bake; painted Height does not change it."
msgstr "曲率はモデルから焼いたものです。描いた Height には追従しません。"

msgid "0 at the bounding box's minimum, 1 at its maximum along this world axis"
msgstr "このワールドの軸に沿って、境界箱のいちばん小さい所が 0、いちばん大きい所が 1"

msgid "Up (+Y)"
msgstr "上（+Y）"

msgid "Down (−Y)"
msgstr "下（−Y）"

msgid "Faces turned toward this world direction get 1, faces at right angles 0.5, faces turned away 0"
msgstr "このワールドの向きを向いた面が 1、直角の面が 0.5、反対を向いた面が 0"

msgid "Read the bent normal (the open directions) instead of the surface normal"
msgstr "面の法線の代わりにベントノーマル（遮られない向き）を読みます"

# ── レベル ──

msgctxt "generator"
msgid "Range"
msgstr "範囲"

msgctxt "generator"
msgid "Low"
msgstr "下限"

msgctxt "generator"
msgid "High"
msgstr "上限"

msgid "Base values at or below this give 0"
msgstr "元の値がこれ以下なら 0"

msgid "Base values at or above this give 1"
msgstr "元の値がこれ以上なら 1"

msgctxt "generator"
msgid "Softness"
msgstr "やわらかさ"

msgid "0 %: a straight ramp from low to high. 100 %: a smooth S curve."
msgstr "0 %: 下限から上限までまっすぐ。100 %: なめらかな S 字。"

msgctxt "generator"
msgid "Invert"
msgstr "反転"

msgid "Swap 0 and 1 after the range"
msgstr "範囲の後で 0 と 1 を入れ替えます"

# ── 崩し ──

msgid "Breakup"
msgstr "崩し"

msgid "Seeded noise that wears the result away in patches, so edges and dirt do not look uniform (100 %: gone where the noise is strongest). The same seed always gives the same result."
msgstr "結果をまだらに削るノイズ（シード付き）で、エッジや汚れを一様に見せません（100 %: ノイズのいちばん強い所では消えます）。同じシードならいつも同じ結果です。"

msgctxt "generator"
msgid "Size"
msgstr "大きさ"

msgid "The size of the largest features, as a fraction of the model's bounding-box diagonal (or of the UV square)"
msgstr "いちばん大きな模様の大きさ（モデルの境界箱の対角線に対する割合。UV なら UV の正方形に対する割合）"

msgctxt "generator"
msgid "Placed"
msgstr "置き場"

msgid "On the model (3D)"
msgstr "モデルの上（3D）"

msgid "UV (seams show)"
msgstr "UV（継ぎ目が出る）"

msgid "On the model: continuous across UV seams (reads the Position map). UV: needs no map, but jumps where UV islands meet."
msgstr "モデルの上: UV の継ぎ目でも途切れません（位置のマップを読みます）。UV: マップは要りませんが、UV アイランドの境目で途切れます。"

# ── 合成 ──

msgid "Combine"
msgstr "合成"

msgid "How the value meets what is below it in the stack (on a mask: how much of the layer shows; white shows)"
msgstr "値とスタックの下の結果の合わせ方（マスクでは、レイヤーの見える度合いに対して。白が見える）"

msgctxt "generator"
msgid "Multiply"
msgstr "乗算"

msgctxt "generator"
msgid "Replace"
msgstr "置き換え"

msgctxt "generator"
msgid "Screen"
msgstr "スクリーン"

msgctxt "generator"
msgid "Max"
msgstr "最大"

msgctxt "generator"
msgid "Min"
msgstr "最小"

msgctxt "generator"
msgid "Add"
msgstr "加算"

msgctxt "generator"
msgid "Subtract"
msgstr "減算"

# ── 書き出し・保存 ──

msgid "Generators without mesh maps"
msgstr "メッシュマップの無い Generator"

msgid "These generators have no usable mesh maps, so the exported images would not have their effect (the layers pass through unchanged):\n{0}\n\nBake the mesh maps first, or export anyway?"
msgstr "次の Generator には使えるメッシュマップが無いので、書き出す画像には効きません（レイヤーはそのまま通ります）:\n{0}\n\n先にメッシュマップを焼きますか、それともこのまま書き出しますか？"

msgid "Export Anyway"
msgstr "このまま書き出す"

msgid "Nothing was exported: some generators have no usable mesh maps. Bake them (Texture Set Settings ▸ Mesh Maps) first."
msgstr "何も書き出していません: 使えるメッシュマップの無い Generator があります。先に焼いてください（テクスチャセットの設定 ▸ メッシュマップ）。"

msgid "{0} generator(s) have no usable mesh maps; they are kept in the file, and the preview images inside it are without their effect."
msgstr "使えるメッシュマップの無い Generator が {0} 個あります。ファイルにはそのまま残り、中のプレビューの画像には効いていません。"
