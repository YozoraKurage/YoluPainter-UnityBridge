# Japanese translation for YoluPainter: layer duplicate, merge and the clipboard (Window/Layers/TexturePaintWindow.LayerOps.cs).
# 語は Photoshop の日本語版に合わせる（レイヤーを複製・下のレイヤーと結合・表示レイヤーを結合・結合部分をコピー・ペースト）。
msgid ""
msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

# ── メニュー ──

msgid "Cut"
msgstr "カット"

msgid "Copy"
msgstr "コピー"

msgid "Copy Merged"
msgstr "結合部分をコピー"

msgid "Paste"
msgstr "ペースト"

msgid "Duplicate Layer"
msgstr "レイヤーを複製"

msgid "Merge Down"
msgstr "下のレイヤーと結合"

msgid "Merge Group"
msgstr "グループを結合"

msgid "Merge Visible"
msgstr "表示レイヤーを結合"

# ── 複製 ──

# 複製したレイヤーの名前（Photoshop の「〜 のコピー」）
msgid "{0} copy"
msgstr "{0} のコピー"

msgid "Duplicated {0}."
msgstr "{0} を複製しました。"

# ── 結合 ──

# 表示レイヤーを結合した層の名前（選んでいた層が結合されないとき）
msgid "Merged"
msgstr "結合"

msgid "Merge Layers"
msgstr "レイヤーを結合"

msgid "Merging changes how the image looks: {0} pixels change by up to {1} levels ({2}). Photoshop changes the look in the same way, for example when the lower layer has another blend mode or a lower opacity, or when layers are clipped to the merged one. Undo brings the layers back."
msgstr "結合すると見た目が変わります: {0} 画素が最大 {1} 段変わります（{2}）。Photoshop でも、たとえば下のレイヤーの描画モードが違う・不透明度が低い、結合するレイヤーにクリッピングされたレイヤーがあるときは同じように見た目が変わります。取り消しでレイヤーは元に戻ります。"

msgid "Merge Anyway"
msgstr "それでも結合"

msgid "Not merged: the look would change."
msgstr "結合しませんでした（見た目が変わるため）。"

msgid "Merged into {0}. The image looks the same."
msgstr "{0} に結合しました。見た目は変わりません。"

msgid "Merged into {0}. {1} pixels changed by up to {2} levels."
msgstr "{0} に結合しました。{1} 画素が最大 {2} 段変わりました。"

# 合成の順番の違いによる 8 bit の丸め（重なった半透明の画素で 1〜2 段）。確かめずに結合して知らせる
msgid "Merged into {0}. {1} pixels differ by rounding (up to {2} levels)."
msgstr "{0} に結合しました。{1} 画素が丸めで最大 {2} 段違います。"

msgid "Filters and generators were baked into the pixels."
msgstr "フィルターと Generator は画素に焼き込みました。"

msgid "Paths became plain pixels."
msgstr "パスはただの画素になりました。"

msgid "Hidden layers inside the group were dropped (Undo brings them back)."
msgstr "グループの中の非表示のレイヤーは捨てました（取り消しで戻ります）。"

msgid "Pixels of switched-off channels were dropped."
msgstr "無効にしていたチャンネルの画素は捨てました。"

# ── クリップボード ──

msgid "Copied {0} × {1} pixels."
msgstr "{0} × {1} 画素をコピーしました。"

msgid "Copied {0} × {1} pixels of the mask."
msgstr "マスクの {0} × {1} 画素をコピーしました。"

msgid "Copied {0} × {1} pixels of the composite."
msgstr "合成の {0} × {1} 画素をコピーしました。"

msgid "Cut {0} × {1} pixels."
msgstr "{0} × {1} 画素をカットしました。"

msgid "The clipboard holds {0} MiB, more than the one-operation budget of {1} MiB. Nothing was pasted."
msgstr "クリップボードは {0} MiB あり、1 回の操作の予算 {1} MiB を超えています。ペーストしませんでした。"

msgid "Pasted as {0}."
msgstr "{0} としてペーストしました。"

msgid "Pasted as {0}, centred (the copy came from a {1} × {2} canvas)."
msgstr "{0} として中央にペーストしました（コピーは {1} × {2} のキャンバスから）。"

msgid "{0} pixels outside the canvas were cut off."
msgstr "キャンバスの外の {0} 画素は切り捨てました。"

# ── 断る理由 ──

msgid "There is no layer below in the same group to merge into."
msgstr "同じグループの中に、結合する下のレイヤーがありません。"

msgid "The layer below is an adjustment layer, which has no pixels to merge into."
msgstr "下のレイヤーは調整レイヤーで、結合する画素がありません。"

msgid "The group is empty: there is nothing to merge."
msgstr "グループが空なので、結合するものがありません。"

msgid "No layer shows anything: there is nothing to merge."
msgstr "見えているレイヤーが無いので、結合するものがありません。"

msgid "There is nothing to copy here."
msgstr "ここにはコピーするものがありません。"

msgid "The copy needs {0} MiB, more than the clipboard limit of {1} MiB (the one-operation budget in Project Settings ▸ YoluPainter). Nothing was copied."
msgstr "コピーには {0} MiB 要り、クリップボードの上限 {1} MiB（Project Settings ▸ YoluPainter の 1 回の操作の予算）を超えます。コピーしませんでした。"

msgid "The result needs more than the one-operation budget of {0} MiB (Project Settings ▸ YoluPainter). Nothing was changed."
msgstr "結果が 1 回の操作の予算 {0} MiB（Project Settings ▸ YoluPainter）を超えます。何も変えていません。"

# Core の文（L.Tr にそのまま渡る）
msgid "The channel is not enabled on this layer."
msgstr "このレイヤーではチャンネルが有効ではありません。"

msgid "The layer has no mask."
msgstr "レイヤーにマスクがありません。"
