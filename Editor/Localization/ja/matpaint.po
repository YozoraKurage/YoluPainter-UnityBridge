# Japanese translation for YoluPainter: painting a material (several channels in one stroke) and each layer's own blend mode and
# opacity per channel.
msgid ""
msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

# ── ブラシの欄 ▸ ブラシのマテリアル（ドックの「マテリアル」のパネルとは別） ──

msgid "Brush Material"
msgstr "ブラシのマテリアル"

msgid "Paint several channels at once"
msgstr "複数のチャンネルを一度に塗る"

msgid "One stroke paints every channel checked below with its own value, using the same dabs (2D and 3D). One undo takes all of them back. Off: the brush paints the selected channel with the foreground color."
msgstr "下でチェックしたチャンネルを、それぞれの値で、同じダブの 1 回のストロークに塗ります（2D と 3D）。1 回の取り消しで全部が戻ります。オフ: 選んでいるチャンネルを描画色で塗ります。"

msgid "{0}: painted by the stroke (click to leave it out)"
msgstr "{0}: ストロークで塗る（クリックで外す）"

msgid "{0}: not painted (click to paint it too)"
msgstr "{0}: 塗らない（クリックで足す）"

msgid "A material paints at least one channel."
msgstr "マテリアルは少なくとも 1 つのチャンネルを塗ります。"

msgid "While you edit a mask, strokes paint the mask only."
msgstr "マスクの編集中は、ストロークはマスクだけを塗ります。"

msgid "The foreground color (also in the Color panel)"
msgstr "描画色（カラーのパネルと同じ）"

msgid "The emission color the stroke paints"
msgstr "ストロークが塗るエミッションの色"

msgid "The Normal value as a direction: +1 leans right"
msgstr "ノーマルの値を向きで: +1 で右に傾く"

msgid "The {0} value the stroke paints"
msgstr "ストロークが塗る{0}の値"

msgid "Showing {0}. The material brush paints the channels checked in Properties ▸ Material."
msgstr "{0}を表示しています。マテリアルのブラシは、プロパティ ▸ マテリアル でチェックしたチャンネルを塗ります。"

# ── プロパティ ▸ ノーマル（マテリアルで塗るとき） ──

msgid "Material value (normal)"
msgstr "マテリアルの値（ノーマル）"

msgid "The material does not paint Normal now. Check it in Properties ▸ Material."
msgstr "今のマテリアルはノーマルを塗りません。プロパティ ▸ マテリアル でチェックしてください。"

# ── レイヤー: チャンネルごとの描画モードと不透明度 ──

msgid "Blend mode and opacity for {0} only. Click to use the layer's again."
msgstr "{0}だけの描画モードと不透明度。クリックでレイヤーの値に戻します。"

msgid "Blend mode and opacity of the layer, shared by every channel without its own. Click to give {0} its own."
msgstr "レイヤーの描画モードと不透明度（自分の値を持たないチャンネル全部に効く）。クリックで{0}に自分の値を持たせます。"

msgid "{0} now has its own blend mode and opacity on this layer."
msgstr "このレイヤーで{0}が自分の描画モードと不透明度を持ちました。"

msgid "{0} uses the layer's blend mode and opacity again."
msgstr "{0}はレイヤーの描画モードと不透明度に戻りました。"

msgid "Own blending per channel"
msgstr "チャンネルごとの描画モード"

msgid "These channels use their own blend mode or opacity instead of the layer's. Select a channel to change its values in the Layers panel."
msgstr "これらのチャンネルは、レイヤーの値の代わりに自分の描画モードか不透明度を使います。チャンネルを選ぶと、レイヤーのパネルでその値を変えられます。"

msgid "Use the layer's blend mode and opacity in {0} again"
msgstr "{0}でレイヤーの描画モードと不透明度に戻す"
