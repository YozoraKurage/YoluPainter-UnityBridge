msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ja\n"

msgid "Keep in Front of Unity Windows"
msgstr "Unity のウィンドウよりいつも手前にする"

msgid "Use a Dockable Unity Window"
msgstr "Unity のレイアウトにドッキングできる普通のウィンドウにする"

msgid "Separate Window Mode"
msgstr "別ウィンドウの表示方法"

msgid "Toggle mesh visibility. Alt-click shows only this mesh."
msgstr "メッシュを表示／非表示にする。Alt クリックでこのメッシュだけを表示。"

msgid "Toggle texture set visibility. Alt-click shows only this set."
msgstr "テクスチャセットを表示／非表示にする。Alt クリックでこのセットだけを表示。"

msgid "Show all meshes and texture sets"
msgstr "すべてのメッシュとテクスチャセットを表示"

msgid "All meshes are hidden."
msgstr "すべてのメッシュが非表示です。"

msgid "The saved view state could not be restored; all meshes are shown."
msgstr "保存した表示状態を復元できなかったため、すべてのメッシュを表示します。"

msgid "Brush color alpha ({0}%) was moved to opacity. Colors are now opaque."
msgstr "ブラシの色のアルファ（{0}%）を不透明度へ移しました。色は不透明になりました。"

msgid "Legacy background alpha was removed. Color mixing now uses opaque colors."
msgstr "以前の背景色のアルファを外しました。色の混合には不透明な色を使います。"

msgid "Brush preset loaded."
msgstr "ブラシプリセットを読み込みました。"

msgid "New Group"
msgstr "新しいグループ"

msgid "Apply Smart Material"
msgstr "スマートマテリアルを適用"

msgid "Apply Selected Smart Material"
msgstr "選択したスマートマテリアルを適用"

msgid "Scene…"
msgstr "シーン…"
