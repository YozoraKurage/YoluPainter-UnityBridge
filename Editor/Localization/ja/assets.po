# Japanese translation for YoluPainter: the Assets panel and the project's resources (importing from the Unity project, image files,
# your library and the built-ins; placing a resource as a layer; checking and updating from the source).
# 一般的な語（Update）は msgctxt "assets" で場面を分ける。
msgid ""
msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

# ── パネル・メニュー ──

msgid "Assets"
msgstr "アセット"

msgid "Import Image Resource…"
msgstr "画像のリソースを取り込む…"

msgid "This Project"
msgstr "このプロジェクト"

msgid "Unity Project"
msgstr "Unity のアセット"

msgid "My Library"
msgstr "自分の置き場"

msgid "Built-in"
msgstr "内蔵"

msgid "The resources this project holds (copied into the .ylp, shared by all texture sets)"
msgstr "このプロジェクトが持つリソース（.ylp に写しを埋め込み、全部のテクスチャセットで共通）"

msgid "Texture2D assets in this Unity project (Assets and Packages); importing copies them and keeps the reference"
msgstr "この Unity のプロジェクトの Texture2D のアセット（Assets と Packages）。取り込むと写しを作り、参照も持ちます"

msgid "Your own library folder (Project Settings > YoluPainter), shared between projects that point at it"
msgstr "自分の置き場のフォルダ（Project Settings > YoluPainter）。同じフォルダを指すプロジェクトで共有します"

msgid "Images that come with YoluPainter"
msgstr "YoluPainter に入っている画像"

msgid "Check the sources again"
msgstr "出どころを確かめ直す"

msgid "Read the list again"
msgstr "一覧を読み直す"

msgid "Search by name"
msgstr "名前で探す"

msgid "Show only one kind of asset"
msgstr "1 つの種類のアセットだけを出す"

msgid "All Kinds"
msgstr "すべての種類"

msgid "Images"
msgstr "画像"

# ── 一覧 ──

msgid "No resource in this project matches the search."
msgstr "このプロジェクトに、探した名前のリソースはありません。"

msgid "This project has no resources yet. Import images from the Unity project, your library or the built-ins, or drop textures from the Project window here."
msgstr "このプロジェクトにはまだリソースがありません。Unity のプロジェクト・自分の置き場・内蔵から画像を取り込むか、Project ウィンドウからテクスチャをここへ落としてください。"

msgid "No texture in the Unity project matches the search."
msgstr "Unity のプロジェクトに、探した名前のテクスチャはありません。"

msgid "The Unity project has no Texture2D assets."
msgstr "Unity のプロジェクトに Texture2D のアセットがありません。"

msgid "No image in your library matches the search."
msgstr "自分の置き場に、探した名前の画像はありません。"

msgid "Your library is empty ({0}). Put resources into it from This Project, or copy PNG and JPEG files into the folder."
msgstr "自分の置き場は空です（{0}）。「このプロジェクト」からリソースを入れるか、PNG・JPEG のファイルをそのフォルダへ写してください。"

msgid "No built-in image matches the search."
msgstr "探した名前の内蔵の画像はありません。"

msgid "Already in this project."
msgstr "このプロジェクトに取り込み済みです。"

msgid "Select an asset to see what you can do with it."
msgstr "アセットを選ぶと、できることが出ます。"

# ── 操作 ──

msgid "Place as Layer"
msgstr "レイヤーとして置く"

msgid "A new layer above the selected one, in the current channel, with the image fitted to the texture set (one undo step)"
msgstr "選んだレイヤーの上に、今のチャンネルの新しいレイヤーを作り、画像をテクスチャセットの大きさに合わせて入れます（1 回の取り消し）"

msgid "Put into My Library (a PNG file in your library folder)"
msgstr "自分の置き場へ入れる（置き場のフォルダの PNG ファイル）"

msgid "Update from the source (when it changed)"
msgstr "出どころから更新する（変わったとき）"

msgid "Remove from this project"
msgstr "このプロジェクトから消す"

msgid "Import into Project"
msgstr "プロジェクトに取り込む"

msgid "Copy it into this project as a resource (the reference to its source is kept)"
msgstr "このプロジェクトにリソースとして写します（出どころへの参照も持ちます）"

msgid "Show it in the Project window"
msgstr "Project ウィンドウで見せる"

msgid "Open your library folder"
msgstr "自分の置き場のフォルダを開く"

msgid "Remove resource?"
msgstr "リソースを消しますか？"

msgid "Remove {0} from this project? Layers already made from it keep their pixels. Its source (if any) is not touched."
msgstr "{0} をこのプロジェクトから消しますか？ これから作ったレイヤーの画素はそのままです。出どころ（あれば）には触れません。"

msgid "Removed {0} from this project."
msgstr "{0} をこのプロジェクトから消しました。"

msgid "{0} is used by {1}; it was not removed."
msgstr "{0} は {1} が使っているので、消しませんでした。"

msgid "Imported {0} ({1} × {2}) from {3} into this project."
msgstr "{0}（{1} × {2}）を {3} からこのプロジェクトに取り込みました。"

msgid "{0} is already in this project as \"{1}\" (the same pixels); nothing was added."
msgstr "{0} はこのプロジェクトに「{1}」として入っています（同じ画素）。何も足していません。"

msgid "{0} is already in your library as {1}."
msgstr "{0} は自分の置き場に {1} として入っています。"

msgid "Put {0} into your library as {1} ({2})."
msgstr "{0} を自分の置き場に {1} として入れました（{2}）。"

msgid "Placing {0} needs {1} MiB, more than the one-operation budget ({2} MiB, Project Settings > YoluPainter). Nothing was placed."
msgstr "{0} を置くには {1} MiB 要り、1 回の操作の予算（{2} MiB、Project Settings > YoluPainter）を超えます。何も置いていません。"

msgid "Placed {0} as a new layer in {1}."
msgstr "{0} を {1} の新しいレイヤーとして置きました。"

msgid "(resized from {0} × {1}, {2})"
msgstr "（{0} × {1} から大きさを合わせました。{2}）"

msgid "area average"
msgstr "面積平均"

msgid "bilinear"
msgstr "バイリニア"

msgid "The texture is no longer in the Unity project."
msgstr "そのテクスチャはもう Unity のプロジェクトにありません。"

msgid "Every resource matches its source."
msgstr "どのリソースも出どころと同じです。"

msgid "The source of {0} resource(s) changed."
msgstr "{0} 個のリソースの出どころが変わっています。"

# ── 出どころ ──

msgid "Unity: {0}"
msgstr "Unity: {0}"

msgid "(read through the GPU)"
msgstr "（GPU を通して読んだもの）"

msgid "File: {0}"
msgstr "ファイル: {0}"

msgid "My Library: {0}"
msgstr "自分の置き場: {0}"

msgid "Built-in: {0}"
msgstr "内蔵: {0}"

msgid "Embedded only"
msgstr "写しだけ（出どころ無し）"

msgid "The Unity asset is gone ({0}); the copy in this project is used."
msgstr "Unity のアセットがありません（{0}）。このプロジェクトの写しを使います。"

msgid "The file is gone ({0}); the copy in this project is used."
msgstr "ファイルがありません（{0}）。このプロジェクトの写しを使います。"

msgid "This YoluPainter has no built-in image \"{0}\"; the copy in this project is used."
msgstr "この YoluPainter には内蔵の画像「{0}」がありません。このプロジェクトの写しを使います。"

msgid "The source could not be read ({0}); the copy in this project is used."
msgstr "出どころを読めませんでした（{0}）。このプロジェクトの写しを使います。"

msgid "{0} matches its source; nothing to update."
msgstr "{0} は出どころと同じです。更新することはありません。"

msgid "Updated {0} from its source ({1} × {2})."
msgstr "{0} を出どころから更新しました（{1} × {2}）。"

msgid "The source of {0} resource(s) is gone ({1}); their copies in this project are used."
msgstr "{0} 個のリソースの出どころがありません（{1}）。このプロジェクトの写しを使います。"

msgid "Resources changed"
msgstr "リソースの出どころが変わりました"

msgid "The source of these resources changed since they were copied into this project:\n\n{0}\n\nUpdate the copies? Layers already made from them keep their pixels."
msgstr "このプロジェクトに写した後で、次のリソースの出どころが変わりました:\n\n{0}\n\n写しを更新しますか？ これから作ったレイヤーの画素はそのままです。"

msgctxt "assets"
msgid "Update"
msgstr "更新する"

msgid "Keep the copies"
msgstr "写しのままにする"

msgid "Updated {0} resource(s) from their sources."
msgstr "{0} 個のリソースを出どころから更新しました。"

msgid "{0} resource(s) changed in their source; the copies in this project are kept (Assets panel ▸ Update to take the new pixels)."
msgstr "{0} 個のリソースの出どころが変わっています。このプロジェクトの写しのままです（新しい画素にするには、アセットのパネル ▸ 更新する）。"

msgid "The source of {0} changed since it was copied into this project."
msgstr "このプロジェクトに写した後で、{0} の出どころが変わりました。"

msgid "The source of {0} resources changed since they were copied into this project."
msgstr "このプロジェクトに写した後で、{0} 個のリソースの出どころが変わりました。"

msgid "Replace the copies with the sources' pixels (the same resources; layers already made keep their pixels)"
msgstr "写しを出どころの画素に置き換えます（同じリソースのまま。作ったレイヤーの画素はそのまま）"

msgid "Go on using the copies; you are told again when the sources change again"
msgstr "写しをそのまま使います。出どころがまた変われば、また知らせます"

msgid "The source changed; you chose to keep the copy."
msgstr "出どころが変わっています（写しのままにすると選びました）。"

msgid "The source changed since it was copied. Update to take the new pixels."
msgstr "写した後で出どころが変わりました。新しい画素にするには更新してください。"

# ── 内蔵の画像 ──

msgid "UV checker"
msgstr "UV チェッカー"

msgid "Grid lines"
msgstr "格子の線"

msgid "Linear gradient"
msgstr "線形のグラデーション"

msgid "Radial gradient"
msgstr "円形のグラデーション"

msgid "Value noise"
msgstr "バリューノイズ"
