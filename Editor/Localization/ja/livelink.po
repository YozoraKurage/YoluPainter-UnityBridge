# Japanese translation for YoluPainter: Live Link (the Live Link window, putting a request for the standalone YoluPainter in the
# Live Link folder, reading its replies and applying exported textures to materials).
msgid ""
msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

# ── 窓 ──

msgid "Target"
msgstr "対象"

msgid "The GameObject in the scene that is opened in YoluPainter. It follows the selection."
msgstr "YoluPainter で開くシーンのゲームオブジェクト。選択に合わせて変わります。"

msgid "Open in YoluPainter"
msgstr "YoluPainter で開く"

msgid "Sends the target to the standalone YoluPainter, and starts it when it is not running. Pressing again sends the pose, BlendShapes and material values again."
msgstr "対象をスタンドアロンの YoluPainter へ送ります（起動していなければ起動します）。もう一度押すと、ポーズ・ブレンドシェイプ・マテリアルの値を送り直します。"

msgid "No GameObject is chosen."
msgstr "ゲームオブジェクトが選ばれていません。"

msgid "A Prefab asset cannot be chosen."
msgstr "プレハブのアセットは選べません。"

msgid "YoluPainter is running"
msgstr "YoluPainter は起動しています"

msgid "YoluPainter is not running"
msgstr "YoluPainter は起動していません"

# ── 状態（印のツールチップと理由の一覧） ──

msgid "Starting YoluPainter…"
msgstr "YoluPainter を起動しています…"

msgid "Sent {0} ({1})"
msgstr "{0} を送りました（{1}）"

msgid "Opened {0} in YoluPainter ({1})"
msgstr "{0} を YoluPainter で開きました（{1}）"

msgid "YoluPainter refused {0} ({1})"
msgstr "YoluPainter が {0} を断りました（{1}）"

msgid "Exported the textures of {0} ({1})"
msgstr "{0} のテクスチャを書き出しました（{1}）"

msgid "{0} was not sent ({1})"
msgstr "{0} を送れませんでした（{1}）"

msgid "Refused"
msgstr "断られました"

msgid "No renderer can be sent"
msgstr "送れるレンダラーがありません"

msgid "The Live Link folder cannot be used"
msgstr "Live Link のフォルダを使えません"

msgid "The request cannot be written"
msgstr "リクエストを書き込めません"

msgid "YoluPainter cannot be started"
msgstr "YoluPainter を起動できません"

# ── 理由 ──

msgid "The mesh is not from an FBX"
msgstr "FBX のメッシュではありません"

msgid "A bone is not in the FBX"
msgstr "FBX に無いボーンがあります"

msgid "Bones with the same name"
msgstr "同じ名前のボーンがあります"

msgid "Bake Axis Conversion is not supported"
msgstr "Bake Axis Conversion には対応していません"

msgid "The FBX cannot be read"
msgstr "FBX を読めません"

msgid "A texture cannot be read"
msgstr "テクスチャを読めません"

msgid "Too large"
msgstr "大きすぎます"

msgid "Not understood by this YoluPainter"
msgstr "この YoluPainter では読めない形式です"

msgid "YoluPainter is busy"
msgstr "YoluPainter が受けられない状態です"

msgid "Opening was canceled in YoluPainter"
msgstr "スタンドアロンで開くのをやめました"

msgid "Outside the Assets folder"
msgstr "Assets フォルダの外です"

msgid "The file cannot be imported"
msgstr "ファイルをインポートできません"

msgid "The material is not found"
msgstr "マテリアルが見つかりません"

msgid "The material is read-only"
msgstr "マテリアルは読み取り専用です"

msgid "The material has no such property"
msgstr "マテリアルにそのプロパティがありません"

# ── マテリアルに適用 ──

msgid "Apply to Materials"
msgstr "マテリアルに適用"

msgid "Apply All"
msgstr "すべて適用"

msgid "Sets every new texture on its material (one undo step)."
msgstr "新しいテクスチャをすべてマテリアルに設定します（1 回で元に戻せます）。"

msgid "Apply Selected"
msgstr "選んだものを適用"

msgid "Sets only the checked rows (one undo step)."
msgstr "チェックした行だけを設定します（1 回で元に戻せます）。"

msgid "Don't Apply"
msgstr "適用しない"

msgid "Keeps the materials as they are. The imported textures stay in the project."
msgstr "マテリアルは変えません。インポートしたテクスチャはプロジェクトに残ります。"

msgid "Apply YoluPainter textures"
msgstr "YoluPainter のテクスチャを適用"

# ── スタンドアロン版のおすすめ（描く窓の小さな窓と Preferences の入切） ──

msgid "The standalone YoluPainter is available"
msgstr "スタンドアロン版の YoluPainter があります"

msgid "Only in the standalone: user channels, noise and grunge, CLIP STUDIO brushes (.sut)"
msgstr "スタンドアロン版だけの機能: ユーザーチャンネル・ノイズとグランジ・CLIP STUDIO のブラシ（.sut）"

msgid "Open the download page"
msgstr "ダウンロードのページを開く"

msgid "Later"
msgstr "あとで"

msgid "Don't show again"
msgstr "今後表示しない"

msgid "Suggest the standalone YoluPainter"
msgstr "スタンドアロン版をすすめる"

msgid "Shows a small window once per editor session when the YoluPainter window is opened."
msgstr "YoluPainter の窓を開いたとき、エディタを起動するごとに 1 回、小さな窓を出します。"

# ── Preferences ──

msgid "YoluPainter executable"
msgstr "YoluPainter の実行ファイル"

msgid "The standalone YoluPainter that Open in YoluPainter starts. When empty, the location written by the Windows installer is used."
msgstr "「YoluPainter で開く」が起動するスタンドアロンの YoluPainter。空のときは、Windows のインストーラーが書いた場所を使います。"

msgctxt "LiveLink"
msgid "Choose…"
msgstr "選ぶ…"

msgid "Choose the YoluPainter executable"
msgstr "YoluPainter の実行ファイルを選ぶ"

msgid "Export folder"
msgstr "書き出し先"

msgid "Where YoluPainter suggests exporting the textures of a target: a folder named after the target, under this folder. Relative to the project."
msgstr "YoluPainter が対象のテクスチャの書き出し先として示す場所: このフォルダの下の、対象の名前のフォルダ。プロジェクトからの相対パス。"
