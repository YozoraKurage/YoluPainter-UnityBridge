# Japanese translation for YoluPainter: short states and refusals that replaced usage explanations, and the tool mouse operations in Help ▸ Keyboard Shortcuts.
msgid ""
msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Clone source set."
msgstr "写し元を設定しました。"

msgid "No clone source"
msgstr "写し元なし"

msgid "No clone source in this view."
msgstr "このビューに写し元がありません。"

msgid "Not a surface of the active texture set."
msgstr "今のテクスチャセットの面ではありません。"

msgid "Smudge and Clone do not work with symmetry."
msgstr "指先とコピースタンプは対称と併用できません。"

msgid "Surface sampling could not reach this dab."
msgstr "面の読み取りがこのダブに届きませんでした。"

msgid "Selection tools: Shift adds · Ctrl subtracts · Shift+Ctrl intersects"
msgstr "選択ツール: Shift で追加 · Ctrl で除外 · Shift+Ctrl で共通部分"

msgid "Move: drag moves · a corner scales · outside the box rotates · arrow keys nudge (Shift: 10 px)"
msgstr "移動: ドラッグで移動 · 角で拡大縮小 · 枠の外で回転 · 矢印キーで少し動かす（Shift で 10 px）"

msgid "Path: click adds a point · drag moves a point · Delete removes the last point"
msgstr "パス: クリックで点を追加 · ドラッグで点を移動 · Delete で最後の点を削除"

msgid "Clone Stamp: Alt+click sets the source · Polygon Fill: click or drag over the model or its UVs"
msgstr "コピースタンプ: Alt＋クリックで写し元 · ポリゴン塗りつぶし: モデルか UV の上をクリック・ドラッグ"

msgid "A path cannot be drawn on a mask."
msgstr "マスクにはパスを描けません。"

msgid "Drawn on another model"
msgstr "別のモデルで描かれたパス"

msgid "No model to draw a path on."
msgstr "パスを描くモデルがありません。"

msgid "Not on this texture set's surface."
msgstr "このテクスチャセットの面ではありません。"

msgid "Rasterized."
msgstr "ラスタライズしました。"

msgid "This layer has a canvas path."
msgstr "このレイヤーには 2D のパスがあります。"

msgid "This layer has a path on the model."
msgstr "このレイヤーにはモデルの上のパスがあります。"

msgid "{0} sample(s) were off the surface and skipped."
msgstr "{0} 個の点が面から外れたので飛ばしました。"

msgid "Distance from the model's origin along the axis, in scene units"
msgstr "モデルの原点から軸に沿った距離（シーンの単位）"

msgid "Symmetry: some copies cannot be seen from this view and were skipped."
msgstr "対称: このビューから見えない写しを飛ばしました。"

msgid "A stroke is in progress."
msgstr "ストロークの途中です。"

msgid "Show the shape in the 3D view with handles"
msgstr "形をハンドル付きで 3D ビューに出す"

msgid "The shape's centre, from the model root (scene units)"
msgstr "モデルのルートから見た形の中心（シーンの単位）"

msgid "No model from a scene is loaded."
msgstr "シーンのモデルを読み込んでいません。"

msgid "The model is a Prefab asset, not a scene object."
msgstr "モデルはシーンの物ではなく Prefab のアセットです。"

msgid "No scene object."
msgstr "シーンの物がありません。"

msgid "The selected layer has no shape gradient."
msgstr "選んだレイヤーに形のグラデーションがありません。"

msgid "Copied the shape of '{0}' ({1})."
msgstr "「{0}」の形を写しました（{1}）。"

msgid "Projection box and shape handles: Ctrl snaps (Unity's Scene snap settings) · Shift resizes both faces"
msgstr "投影の箱と形のハンドル: Ctrl でスナップ（Unity のシーンのスナップ設定） · Shift で両面の大きさを変える"

msgid "No model in the 3D view."
msgstr "3D ビューにモデルがありません。"

msgid "Not on the model."
msgstr "モデルの上ではありません。"

msgid "That face belongs to the texture set {0}."
msgstr "その面はテクスチャセット {0} のものです。"

msgid "Placed {0} as a decal in {1}."
msgstr "{0} を {1} のデカールとして置きました。"

msgid "Added {0} to the mask."
msgstr "マスクに {0} を足しました。"

msgid "Added {0} to the {1} pixels."
msgstr "{1} の画素に {0} を足しました。"

msgid "Baked the filters into the layer's pixels."
msgstr "フィルターをレイヤーの画素に焼き込みました。"

msgid "Transparency kept (locked)."
msgstr "透明度は保ちました（ロック中）。"

msgid "The same seed gives the same noise."
msgstr "同じシードなら同じノイズになります。"

msgid "No effect: {0}"
msgstr "効果なし: {0}"

msgid "no anchor below this layer"
msgstr "このレイヤーより下にアンカーがない"

msgid "Open the bake window"
msgstr "ベイクのウィンドウを開く"

msgid "On: keep reading this bake. Off: follow the latest bake."
msgstr "オン: このベイクを読み続ける。オフ: 最新のベイクに従う。"

msgid "Seeded noise that wears the result away in patches"
msgstr "シード付きのノイズで結果をまだらに削る"

msgid "Nothing was exported: some generators have no usable mesh maps."
msgstr "何も書き出していません: 使えるメッシュマップの無い Generator があります。"

msgid "{0} generator(s) have no usable mesh maps."
msgstr "{0} 個の Generator に使えるメッシュマップがありません。"

msgid "Texture sets keep their pixels and move to the materials below (matched by asset, then by name)."
msgstr "テクスチャセットは画素を保ったまま下のマテリアルへ移ります（アセット、次に名前で対応付け）。"

msgid "Several YoluPainter windows are open."
msgstr "YoluPainter のウィンドウが複数開いています。"

msgid "The material changed since the list was made; nothing was applied."
msgstr "一覧を作った後にマテリアルが変わりました。何も適用していません。"

msgid "{0}: a preview-only texture cannot be saved in the material."
msgstr "{0}: プレビューだけのテクスチャはマテリアルに保存できません。"

msgid "The inspector changed the shader; that change was cancelled."
msgstr "インスペクターがシェーダーを変えたので、その変更を取り消しました。"

msgid "No generator reads this anchor."
msgstr "このアンカーを読む Generator はありません。"

msgid "No resources"
msgstr "リソースなし"

msgid "No smart masks"
msgstr "スマートマスクなし"

msgid "No smart materials"
msgstr "スマートマテリアルなし"

msgid "Only Color and Emission use color dynamics."
msgstr "カラーのダイナミクスはカラーとエミッションだけに効きます。"

msgid "No mesh maps are baked for this texture set."
msgstr "このテクスチャセットのメッシュマップはベイクされていません。"

msgid "{0} is not baked for this texture set."
msgstr "このテクスチャセットの {0} はベイクされていません。"

msgid "Only a paint layer or a mask takes a gradient."
msgstr "グラデーションはペイントのレイヤーかマスクにだけ描けます。"

msgid "That would scale to nothing."
msgstr "大きさが 0 になります。"

msgid "The Normal channel paints a direction."
msgstr "ノーマルのチャンネルは向きを塗ります。"

msgid "Environment: {0}"
msgstr "環境: {0}"

msgid "No texture."
msgstr "テクスチャがありません。"

msgid "Nothing was exported: texture sets {0} would write the same file {1}."
msgstr "何も書き出していません: テクスチャセット {0} が同じファイル {1} に書きます。"

msgid "Show or hide the projection's box and its handles in the 3D view (Q)"
msgstr "投影の箱とハンドルを 3D ビューに出す・隠す（Q）"

msgid "The box's centre, from the model root (scene units)"
msgstr "モデルのルートから見た箱の中心（シーンの単位）"

msgid "Handles hidden while the mask is edited"
msgstr "マスクの編集中はハンドルを隠しています"

msgid "No images"
msgstr "画像なし"

msgid "The 3D view is hidden."
msgstr "3D ビューが隠れています。"

msgid "{0} fill channel(s) read an image this project does not have; they show their fill value (the reference is kept): {1}"
msgstr "{0} 個の塗りつぶしのチャンネルが、このプロジェクトに無い画像を読んでいます。塗りつぶしの値を出しています（参照は残します）: {1}"

msgid "Colours mix in sRGB; data channels use the stops' luminance; opacity is separate."
msgstr "色は sRGB で混ぜます。データのチャンネルは止めの輝度を使い、不透明度は別に持ちます。"

msgid "Manual ID colours changed."
msgstr "部品の ID 色を変えました。"

msgid "These manual colours belong to another model."
msgstr "この部品の色は別のモデルのものです。"

msgid "Colours from: {0}"
msgstr "色の元: {0}"

msgid "No colours"
msgstr "色なし"

msgid "Picking ID colours"
msgstr "ID の色を取っています"

msgid "This generator reads another ID bake (Only this bake)."
msgstr "この Generator は別の ID のベイクを読んでいます（このベイクだけを読む）。"

msgid "A fill layer cannot be cut."
msgstr "塗りつぶしのレイヤーは切り取れません。"

msgid "Hidden layers are not merged."
msgstr "非表示のレイヤーは結合しません。"

msgid "No layer is selected."
msgstr "レイヤーを選んでいません。"

msgid "Only layers in the same group can be merged together."
msgstr "結合できるのは同じグループの中のレイヤーどうしだけです。"

msgid "The clipboard is empty."
msgstr "クリップボードが空です。"

msgid "The layer below is a group."
msgstr "下のレイヤーはグループです。"

msgid "This is a group."
msgstr "グループです。"

msgid "This is not a group."
msgstr "グループではありません。"

msgid "This layer has no pixels to copy."
msgstr "このレイヤーにはコピーする画素がありません。"

msgid "This layer is drawn by a path."
msgstr "このレイヤーはパスで描かれています。"

msgid "At least one layer must remain."
msgstr "レイヤーは 1 つ以上必要です。"

msgid "Only layers in the same group can be grouped together."
msgstr "グループにできるのは同じグループの中のレイヤーどうしだけです。"

msgid "No folder inside Assets was chosen for the lilToon textures."
msgstr "lilToon のテクスチャを置く Assets の中のフォルダーが選ばれていません。"

msgid "Painting the layer mask"
msgstr "レイヤーマスクに描いています"

msgid "Applied {0} change(s) to {1}."
msgstr "{1} に {0} 件の変更を適用しました。"

msgid "Discarded {0} preview-only material change(s) of materials that are not in this model."
msgstr "このモデルに無いマテリアルの、プレビューだけの変更 {0} 件を捨てました。"

msgid "No source material"
msgstr "元のマテリアルなし"

msgid "Reverted {0} change(s)."
msgstr "{0} 件の変更を元に戻しました。"

msgid "Mesh maps are baked only from a complete static snapshot that can be painted; this one is incomplete."
msgstr "メッシュマップは描ける完全な静的スナップショットからだけベイクします。このスナップショットは不完全です。"

msgid "No high poly: tangent normal, height and opacity are uniform."
msgstr "高ポリなし: タンジェントのノーマル・ハイト・不透明度は一様です。"

msgid "No high poly: this ID map is one colour."
msgstr "高ポリなし: この ID マップは 1 色です。"

msgid "No high poly: this map is uniform."
msgstr "高ポリなし: このマップは一様です。"

msgid "Not checked: no model is loaded."
msgstr "未確認: モデルを読み込んでいません。"

msgid "{0} is stale and is not used: {1}"
msgstr "{0} は古いので使いません: {1}"

msgid "Cleared the mesh maps."
msgstr "メッシュマップを消しました。"

msgid "Not saved yet"
msgstr "未保存"

msgid "The model is being prepared."
msgstr "モデルを準備しています。"

msgid "Height also shapes the Normal output."
msgstr "ハイトもノーマルの出力の形を作ります。"

msgid "Height → Normal off"
msgstr "ハイト → ノーマル: オフ"

msgid "Height → Normal on"
msgstr "ハイト → ノーマル: オン"

msgid "Normal files: {0}"
msgstr "ノーマルのファイル: {0}"

msgid "The material does not paint Normal."
msgstr "マテリアルはノーマルを塗りません。"

msgid "{0} replaces the normals below (like Normal)."
msgstr "{0} は下の法線を置き換えます（通常と同じ）。"

msgid "A group has no pixels."
msgstr "グループには画素がありません。"

msgid "This preview snapshot is not safe to paint."
msgstr "このプレビューのスナップショットには安全に描けません。"

msgid "UV candidate {0}/{1}"
msgstr "UV の候補 {0}/{1}"

msgid "Pose applied to the preview."
msgstr "プレビューにポーズを当てました。"

msgid "3D view: {0} shows a new material of the shader {1}."
msgstr "3D ビュー: {0} をシェーダー {1} の新しいマテリアルで見せています。"

msgid "3D view: {0} shows the material {1}."
msgstr "3D ビュー: {0} をマテリアル {1} で見せています。"

msgid "No material."
msgstr "マテリアルがありません。"

msgid "No shader."
msgstr "シェーダーがありません。"

msgid "The model and the texture set sizes cannot change at once; nothing changed."
msgstr "モデルとテクスチャセットの大きさは一度に変えられません。何も変えていません。"

msgid "Not a material asset of the Unity project."
msgstr "Unity のプロジェクトのマテリアルのアセットではありません。"

msgid "The tool icon was changed."
msgstr "ツールのアイコンを変えました。"

msgid "Its generators have no effect: no mesh maps are baked."
msgstr "Generator は効いていません: メッシュマップがベイクされていません。"

msgid "This texture set does not use {0}: those values were placed switched off."
msgstr "このテクスチャセットは {0} を使いません: その値はオフにして置きました。"

msgid "An image the brush paints through, laid over the 2D canvas and the 3D view"
msgstr "2D キャンバスと 3D ビューに重ね、ブラシがその形で塗る画像"

msgid "Colour with material painting: Base Color takes the colours, the other channels only the alpha. A mask takes only the alpha."
msgstr "マテリアルで塗るときのカラー: ベースカラーは画像の色、ほかのチャンネルはアルファだけを使います。マスクはアルファだけを使います。"

msgid "No stencil image."
msgstr "ステンシルの画像がありません。"

msgid "Stencil: {0}"
msgstr "ステンシル: {0}"

msgid "Only a paint layer or a mask can be filled."
msgstr "塗りつぶせるのはペイントのレイヤーかマスクだけです。"

msgid "A group has no pixels to move."
msgstr "グループには動かす画素がありません。"

msgid "The saved file changed outside this window; Save is blocked (Save As still works)."
msgstr "保存したファイルがこのウィンドウの外で変わりました。上書き保存は止めています（別名で保存はできます）。"

msgid "{0}: {1} is off on this material, so the painted {0} does not show."
msgstr "{0}: このマテリアルでは {1} がオフなので、描いた{0}は表示されません。"

msgid "No environment texture; the built-in sky is shown."
msgstr "環境テクスチャなし（内蔵の空を表示）"

msgid "{0} has its image pixels locked."
msgstr "{0}は画像の画素がロックされています。"

msgid "{0} has its position locked."
msgstr "{0}は位置がロックされています。"

msgid "{0} has its transparent pixels locked: this would change their transparency."
msgstr "{0}は透明画素がロックされています。透明度が変わってしまいます。"

msgid "{0} is locked."
msgstr "{0}はロックされています。"

msgid "New project without a model."
msgstr "モデルなしの新しいプロジェクト"

msgid "Channel: {0}"
msgstr "チャンネル: {0}"

msgid "This face belongs to the texture set {0}."
msgstr "この面はテクスチャセット {0} のものです。"

msgid "This face uses the material {0}, which has no texture set in this project."
msgstr "この面はマテリアル {0} を使っていますが、このプロジェクトにはそのテクスチャセットがありません。"

msgid "No selection"
msgstr "選択範囲なし"

msgid "There is no usable ID map for this texture set: {0}"
msgstr "このテクスチャセットに使える ID マップがありません: {0}"

msgid "Added the texture set {0}."
msgstr "テクスチャセット {0} を追加しました。"

msgid "No export padding: no model in the 3D view, so the UVs are unknown."
msgstr "書き出しのパディングなし: 3D ビューにモデルがなく、UV が分かりません。"

msgid "{0} works on the 2D canvas."
msgstr "{0} は 2D キャンバスで使います。"

msgid "Imported {0}; the PSD itself is never rewritten."
msgstr "{0} を取り込みました。元の PSD は書き換えません。"
