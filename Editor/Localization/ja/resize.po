# Japanese translation for YoluPainter: changing a texture set's size (Project Configuration: the size of each set, the
# resampling, the confirmation and the notes after resizing).
msgid ""
msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

# ── プロジェクト設定の画面 ──

msgid "A texture set's size must be one of {0}."
msgstr "テクスチャセットの大きさは {0} のどれかにしてください。"

msgid "Resized texture sets are resampled when you apply; their undo history is cleared."
msgstr "大きさを変えたテクスチャセットは、適用すると再標本化し、そのセットの履歴は消えます。"

msgid "Choose a texture set's size in its row above."
msgstr "テクスチャセットの大きさは、上の並びの各行で選びます。"

msgid "Automatic"
msgstr "自動"

msgid "Area average"
msgstr "面積平均"

msgid "Size of the new texture set"
msgstr "足すテクスチャセットの大きさ"

msgid "Size of this texture set (now {0} × {1}). A new size resamples its layers when you apply."
msgstr "このテクスチャセットの大きさ（今は {0} × {1}）。違う大きさにすると、適用したときにレイヤーを再標本化します。"

msgctxt "size"
msgid "current"
msgstr "今"

# ── 確かめと知らせ ──

msgid "Resize texture sets?"
msgstr "テクスチャセットの大きさを変えますか？"

msgid "Resize"
msgstr "大きさを変える"

msgid "Every layer, mask and the selection are resampled. The undo history of these texture sets is cleared, and the resize cannot be undone (the saved file keeps the old size until you save). Their baked mesh maps become stale."
msgstr "全部のレイヤー・マスクと選択範囲を再標本化します。これらのテクスチャセットの履歴は消え、大きさの変更は元に戻せません（保存したファイルには、次に保存するまで前の大きさが残ります）。ベイクしたメッシュマップは古くなります。"

msgid "Resampling {0} to {1} × {2}…"
msgstr "{0} を {1} × {2} に再標本化しています…"

msgid "{0} is now {1} × {2}."
msgstr "{0} は {1} × {2} になりました。"

msgid "The path on the layer {0} was resampled, not redrawn: its model is not loaded. Redraw it in the Path section when it is."
msgstr "レイヤー {0} のパスは描き直さず、画素を再標本化しました（そのモデルを読み込んでいません）。読み込んだら、パスの欄で描き直してください。"

msgid "The path on the layer {0} was resampled, not redrawn: {1}"
msgstr "レイヤー {0} のパスは描き直さず、画素を再標本化しました: {1}"
