msgstr "全体を映す"

msgid "From the +Z side, where a Unity character faces"
msgstr "+Z の側（Unity のキャラクターが向く側）から"

msgid "From the character's left (−X)"
msgstr "キャラクターの左（−X）から"

msgid "From the character's right (+X)"
msgstr "キャラクターの右（+X）から"

