msgid "Black to white"
msgstr "黒から白"

msgid "White to black"
msgstr "白から黒"

msgid "Foreground to background"
msgstr "描画色から背景色"

msgid "Foreground to transparent"
msgstr "描画色から透明"

msgid "Warm to cool"
msgstr "暖色から寒色"

msgid "Color / Value Gradient"
msgstr "色・値のグラデーション"

msgid "Map the shape's value through color or value stops and independent opacity stops. Off keeps the original scalar generator."
msgstr "形の値を色・値と不透明度の分岐点で変換します。無効なら従来の値の Generator を使います。"

msgid "Gradient Presets…"
msgstr "グラデーションのプリセット…"

msgid "Stop Position"
msgstr "分岐点の位置"

msgid "Stop Opacity"
msgstr "分岐点の不透明度"

msgid "Segment Midpoint"
msgstr "区間の中点"

msgid "Stop Value"
msgstr "分岐点の値"

msgid "Choose this stop's color"
msgstr "分岐点の色を選ぶ"

msgid "Remove Stop"
msgstr "分岐点を削除"

msgid "Value Curve"
msgstr "値のカーブ"

msgid "Curve Presets…"
msgstr "カーブのプリセット…"

msgid "Shape value in, gradient position out. Click to add a point, drag to move, right-click to remove. Escape cancels."
msgstr "形の値を入力、勾配上の位置を出力にします。クリックで点を追加、ドラッグで移動、右クリックで削除。Escape で取消。"

msgid "RGB: Classic interpolation in sRGB. Data channels use stored-value luminance; opacity is independent."
msgstr "RGB は sRGB の値で Classic 補間。データのチャンネルは格納値の輝度を使い、不透明度は独立です。"

msgid "Top: opacity stops. Bottom: color or value stops. Click to add, drag to move, right-click or drag outside to remove. Small diamonds move the midpoint. Escape cancels a drag."
msgstr "上は不透明度、下は色・値の分岐点。クリックで追加、ドラッグで移動、右クリックか枠の外へドラッグで削除。小さい印は中点。Escape でドラッグを取り消します。"

msgid "Add World Space Gradient"
msgstr "ワールドスペースの勾配を追加"

msgid "World Space Gradient"
msgstr "ワールドスペースの勾配"

msgid "Remove World Space Gradient"
msgstr "ワールドスペースの勾配を削除"

msgid "Placement in the model root's space, in scene units."
msgstr "モデルのルートを基準にした配置（シーンの単位）。"

msgid "Gradient unavailable; the fallback value is shown. {0}"
msgstr "勾配を使えないため、代わりの値を表示しています。{0}"

msgid "Ctrl: snap movement, size and rotation using Unity's Scene snap settings. Shift: resize both faces. Handles are drawn in front of the model."
msgstr "Ctrl で Unity のシーンの設定に従って移動・大きさ・回転を刻みます。Shift で両面の大きさを変更。ハンドルはモデルの手前に描きます。"

msgctxt "shape gradient"
msgid "Move"
msgstr "移動"

msgctxt "shape gradient"
msgid "Rotate"
msgstr "回転"

msgid "Handles: rotate (rings about the model's axes; Ctrl uses Unity's Scene rotation increment)"
msgstr "ハンドル: 回転（モデルの軸を中心とするリング。Ctrl は Unity のシーンの回転の刻みを使います）"

msgid "Decal gradient unavailable; it is transparent. {0}"
msgstr "デカールの勾配を使えないため、透明にしています。{0}"
